# haai configuration via environment variables
# Copy to .env and fill in as needed

# Docker Compose — external (host) ports mapped into containers
HAAI_HOST_PROXY_PORT=4000
HAAI_HOST_WEB_PORT=5173
HAAI_HOST_MOCK_PORT=11434

# Public URLs shown in the startup banner (auto-set by docker-compose from host ports above)
# HAAI_URL=http://localhost:4000
# HAAI_WEB_URL=http://localhost:5173

# Server
HAAI_HOST=0.0.0.0
HAAI_PORT=4000

# Data directory (default: ~/.haai)
# HAAI_DATA_DIR=/path/to/data

# Log level: trace | debug | info | warn | error | fatal
HAAI_LOG_LEVEL=info

# Log format: json | pretty
HAAI_LOG_FORMAT=json

# TLS (optional)
# HAAI_TLS_CERT=/path/to/cert.pem
# HAAI_TLS_KEY=/path/to/key.pem

# Admin initial setup (only used on first run to create admin user)
# HAAI_ADMIN_USER=admin
# HAAI_ADMIN_PASSWORD=admin

# Passkeys / WebAuthn (optional; auto-detected from Host header in dev)
# HAAI_WEBAUTHN_RP_ID=localhost
# HAAI_WEBAUTHN_ORIGINS=http://localhost:4000,http://localhost:5173

# CORS allowed origins (comma-separated, * for all)
# When using Docker Compose with custom host ports, include both URLs, e.g.:
# HAAI_CORS_ORIGINS=http://localhost:4000,http://localhost:5173
HAAI_CORS_ORIGINS=http://localhost:4000,http://localhost:5173

# Metrics
HAAI_METRICS_ENABLED=true
# HAAI_OTEL_ENDPOINT=http://localhost:4318

# Health check interval in seconds
HAAI_HEALTH_CHECK_INTERVAL=30
